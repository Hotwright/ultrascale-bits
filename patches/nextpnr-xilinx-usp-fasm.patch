+    // A bidirectional pip appears in the chipdb twice: bbaexport emits
+    // addPIP(p, false) then addPIP(p, true), so the canonical direction always
+    // has the lower tile-local index. prjuray names the feature by the
+    // CANONICAL pair and says which way the signal goes with a suffix -- both
+    //   INT.PIP.BYPASS_W8.INT_NODE_IMUX_37_INT_OUT0.FWD
+    //   INT.PIP.BYPASS_W8.INT_NODE_IMUX_37_INT_OUT0.REV
+    // exist, on separate bits, with dst and src the same way round in each. So
+    // when this pip is the reverse one, the names must be swapped BACK before
+    // printing, not just tagged. Writing the swapped names plus ".REV" produces
+    // a feature prjuray has never heard of, which assembles to nothing.
+    //
+    // Sets swap=true when the caller should print (src, dst) instead of
+    // (dst, src). Returns "" for a one-way pip.
+    std::string usp_pip_direction_suffix(PipId pip, bool &swap)
+    {
+        swap = false;
+        auto &li = ctx->locInfo(pip);
+        auto &pd = li.pip_data[pip.index];
+        auto &dw = li.wire_data[pd.dst_index];
+        for (int k = 0; k < dw.num_downhill; k++) {
+            int idx = dw.pips_downhill[k];
+            if (li.pip_data[idx].dst_index == pd.src_index) {
+                if (pip.index < idx)
+                    return ".FWD";
+                swap = true;
+                return ".REV";
+            }
+        }
+        return "";
+    }
+
+    // CLK_LEAF_SITES_<n>_CLK_IN -> BUFCE_LEAF_X<x>Y<y>, built once from the
+    // generated table. See tools/gen_usp_bufce_leaf.py for why a table.
+    std::unordered_map<std::string, std::string> usp_bufce_leaf;
+    bool usp_bufce_leaf_built = false;
+    void build_usp_bufce_leaf()
+    {
+        if (usp_bufce_leaf_built)
+            return;
+        usp_bufce_leaf_built = true;
+#define USP_BUFCE_LEAF(tt, wire, site) usp_bufce_leaf[std::string(tt) + "/" + (wire)] = site;
+#include "usp_bufce_leaf.inc"
+#undef USP_BUFCE_LEAF
+    }
+
+    // HDIO_LOGICPAIR_<n>_OPFF{M,S}_Q -> HDIOLOGIC_{M,S}_X<x>Y<y>. Same reason
+    // as usp_bufce_leaf: the chipdb carries no site for these route-throughs,
+    // so the site cannot be recovered at runtime. See
+    // tools/gen_usp_hdio_optff.py.
+    std::unordered_map<std::string, std::string> usp_hdio_optff;
+    bool usp_hdio_optff_built = false;
+    void build_usp_hdio_optff()
+    {
+        if (usp_hdio_optff_built)
+            return;
+        usp_hdio_optff_built = true;
+#define USP_HDIO_OPTFF(tt, wire, site) usp_hdio_optff[std::string(tt) + "/" + (wire)] = site;
+#include "usp_hdio_optff.inc"
+#undef USP_HDIO_OPTFF
+    }
+
+    // UltraScale+ pips whose configuration is NOT a routing bit. Mostly
+    // route-throughs -- a pip that passes through a site is selected by that
+    // site's own configuration -- plus the PS interface, whose whole
+    // configuration is one tile-level enable. prjuray has no pip feature for
+    // any of them, and writing one assembles to nothing, silently.
+    // Returns true when the pip was consumed here.
+    bool write_pip_as_site_config_usp(PipId pip)
+    {
+        auto &li = ctx->locInfo(pip);
+        auto &pd = li.pip_data[pip.index];
+        std::string tt = IdString(li.type).str(ctx);
+        std::string dst = IdString(li.wire_data[pd.dst_index].name).str(ctx);
+        std::string src = IdString(li.wire_data[pd.src_index].name).str(ctx);
+
+        // The HDIOB output and input buffers. Configured by
+        // write_io_config_usp() as IOB_X<x>Y<y>.IOSTANDARD_{IN,OUT}.*, and
+        // prjuray has no HDIO_IOBPAIR pip feature at all.
+        if (boost::starts_with(dst, "HDIO_IOBPAIR_") || boost::starts_with(src, "HDIO_IOBPAIR_"))
+            return true;
+        // The HDIO input flip-flop bypass. prjuray has no IPFF feature of any
+        // kind for these tiles, so there is nothing to write.
+        if (boost::contains(dst, "_IPFF") || boost::contains(src, "_IPFF"))
+            return true;
+
+        // The leaf clock buffer. dump_features.tcl: a pip in RCLK_INT_L/R whose
+        // downhill wire is CLK_LEAF_SITES_*_CLK_LEAF and whose uphill wire ends
+        // _CLK_IN yields <site>.BUFCE_LEAF.IN_USE.V1.
+        if ((tt == "RCLK_INT_L" || tt == "RCLK_INT_R") && boost::starts_with(dst, "CLK_LEAF_SITES_") &&
+            boost::ends_with(dst, "_CLK_LEAF") && boost::ends_with(src, "_CLK_IN")) {
+            build_usp_bufce_leaf();
+            auto it = usp_bufce_leaf.find(tt + "/" + src);
+            if (it == usp_bufce_leaf.end()) {
+                log_warning("no BUFCE_LEAF site known for %s.%s; regenerate usp_bufce_leaf.inc\n", tt.c_str(),
+                            src.c_str());
+                return true;
+            }
+            push(get_tile_name(pip.tile));
+            push(it->second);
+            push("BUFCE_LEAF");
+            write_choice("IN_USE", "V1");
+            // dump_features.tcl writes four more for a leaf that has a cell in
+            // it: CE_TYPE, and one <pin>INV per IS_*_INVERTED property. Three
+            // of the five are clear-only in the database and cost nothing, but
+            // IINV.V1 and DELAY_TAP.V0 each SET a bit -- and leaving DELAY_TAP
+            // entirely clear encodes no tap at all, since none of
+            // V0/V1/V2/V4/V8 matches an all-clear pattern.
+            //
+            // Values measured from the Vivado reference (env/reference_build.sh
+            // on kv260_ps_blink): its one in-use leaf is IINV.V1, DELAY_TAP.V0,
+            // CE_TYPE.SYNC, CEINV.V0, while all 31 unused leaves in the same
+            // bitstream decode as IINV.V0 with no tap. So V1 is what "this leaf
+            // is driving" looks like physically: prjuray's IINV is the bit, not
+            // the logical IS_I_INVERTED, which dump_features.tcl XORs with the
+            // site pin's own inversion before writing. DELAY_TAP.V0 is no
+            // deskew, which is what a design with no timing constraint gets.
+            write_choice("CE_TYPE", "SYNC");
+            write_choice("CEINV", "V0");
+            write_choice("IINV", "V1");
+            write_choice("DELAY_TAP", "V0");
+            pop(3);
+            return true;
+        }
+
+        // The PS interface. Record the tile so write_pss_intf_usp() can set its
+        // one enable bit; the pip itself has no bits, so drop it.
+        if (tt == "INT_INTF_LEFT_TERM_PSS") {
+            if (getenv("NEXTPNR_RT_TRACE"))
+                log_info("PSS %s  %s <- %s\n", get_tile_name(pip.tile).c_str(), dst.c_str(), src.c_str());
+            if (boost::contains(dst, "LOGIC_OUTS") || boost::contains(src, "LOGIC_OUTS"))
+                usp_pss_outputs_enabled.insert(pip.tile);
+            return true;
+        }
+
+        // The clock tri-state/ESD driver. prjuray has a pip feature for what
+        // drives ITS output onward (CLK_BUFCE_ROW_FSR_n_CLK_IN <- ..._SCHMITT_B)
+        // but none for the track that drives the driver: that is carried by
+        // WIRE.CLK_VDISTR_*.USED.V1, which write_clocking_usp() emits.
+        if (boost::contains(dst, "CLK_CMT_DRVR_TRI_ESD") && boost::ends_with(dst, "_SCHMITT_B"))
+            return true;
+
+        // The row clock buffer. prjuray has a pip feature for its INPUT mux
+        // (CLK_BUFCE_ROW_FSR_n_CLK_IN <- ...) but none for the buffer itself.
+        if (boost::starts_with(dst, "CLK_BUFCE_ROW_FSR") && boost::ends_with(dst, "_CLK_OUT"))
+            return true;
+
+        return false;
+    }
+
+    // Some UltraScale+ route-throughs need BOTH a pip feature and the passed
+    // site's own configuration. Unlike write_pip_as_site_config_usp() this does
+    // not consume the pip: prjuray has a real pip feature as well, and Vivado
+    // writes both.
+    void write_usp_extra_site_config(PipId pip)
+    {
+        auto &li = ctx->locInfo(pip);
+        auto &pd = li.pip_data[pip.index];
+        std::string dst = IdString(li.wire_data[pd.dst_index].name).str(ctx);
+        std::string src = IdString(li.wire_data[pd.src_index].name).str(ctx);
+
+        // The HDIO output flip-flop bypass, which is two features, not one:
+        //
+        //   PIP.HDIO_LOGICPAIR_35_OPFFM_Q.HDIO_LOGICPAIR_35_OPFFM_D1  00_830
+        //   HDIOLOGIC_M_X0Y3.OQ_MUX.NOT_OPTFF                        !00_826 01_825
+        //
+        // The pip bit says the route passes through the site; the site's own
+        // output mux says what drives the pad. Writing only the first leaves
+        // the mux bits matching NEITHER choice -- NOT_OPTFF wants 01_825 set,
+        // OPTFF wants 00_826 set, and we left both clear. Vivado sets both
+        // features on every HDIOLOGIC site driving a pin, and adding them made
+        // our two HDIO tiles match its bitstream bit for bit.
+        if (boost::contains(dst, "_OPFF") && boost::ends_with(dst, "_Q") &&
+            boost::contains(src, "_OPFF") && boost::ends_with(src, "_D1")) {
+            // The site has to come from a table. pd.site, both wires' site
+            // and the wires' bel pins are all -1/absent for these pips -- all
+            // eight in kv260_ps_blink -- exactly as for BUFCE_LEAF, and the
+            // wire number is not the site number either (HDIO_LOGICPAIR_14 is
+            // HDIOLOGIC_M_X0Y0, _15 is HDIOLOGIC_S_X0Y0).
+            build_usp_hdio_optff();
+            std::string tt = IdString(li.type).str(ctx);
+            auto it = usp_hdio_optff.find(tt + "/" + dst);
+            if (it == usp_hdio_optff.end()) {
+                log_warning("no HDIOLOGIC site known for %s.%s; regenerate usp_hdio_optff.inc\n", tt.c_str(),
+                            dst.c_str());
+                return;
+            }
+            push(get_tile_name(pip.tile));
+            push(it->second);
+            write_choice("OQ_MUX", "NOT_OPTFF");
+            pop(2);
+        }
+    }
