+    // ------------------------------------------------------------------
+    // UltraScale+ IO and clocking
+    //
+    // The rules below are transcribed from prjuray's own model of a routed
+    // design, prjuray/tools/dump_features.tcl -- the Tcl that turns a Vivado
+    // result into the feature list its fuzzers then solve. That file, not the
+    // segbits, is the specification; the segbits only say which of those
+    // features were successfully solved.
+    pool<int> usp_hv_banks, usp_lv_banks;
+
+    // prjuray's site_index_in_tile: a site is named by its position within the
+    // tile, counted over every site sharing its NAME PREFIX.
+    //
+    // getSiteLocInTile() cannot be used for this. bbaexport computes rel_x/rel_y
+    // per site TYPE, and an HDIO tile holds HDIOB_M and HDIOB_S sites
+    // interleaved, so each type restarts at zero and the two collide: eight
+    // distinct pads came out as IOB_X0Y{0,2,4,6} with every name used twice.
+    // prjuray numbers them across both -- IOB_X0Y0 is the first HDIOB_M,
+    // IOB_X0Y1 the first HDIOB_S, and so on to IOB_X0Y11.
+    std::string usp_site_index_in_tile(BelId bel)
+    {
+        return usp_site_index_name(bel.tile, ctx->locInfo(bel).bel_data[bel.index].site);
+    }
+
+    // The same naming from a raw site index, which is what PipInfoPOD carries
+    // for a route-through (pip_data[].site) -- no BelId is involved there.
+    std::string usp_site_index_name(int tile, int si)
+    {
+        auto &ti = ctx->chip_info->tile_insts[tile];
+        NPNR_ASSERT(si >= 0 && si < ti.num_sites);
+        std::string name = ti.site_insts[si].name.get();
+        auto xpos = name.rfind("_X");
+        std::string prefix = (xpos == std::string::npos) ? name : name.substr(0, xpos);
+        int min_x = ti.site_insts[si].site_x, min_y = ti.site_insts[si].site_y;
+        for (int i = 0; i < ti.num_sites; i++) {
+            std::string other = ti.site_insts[i].name.get();
+            auto opos = other.rfind("_X");
+            if (opos == std::string::npos || other.substr(0, opos) != prefix)
+                continue;
+            min_x = std::min(min_x, ti.site_insts[i].site_x);
+            min_y = std::min(min_y, ti.site_insts[i].site_y);
+        }
+        return prefix + "_X" + std::to_string(ti.site_insts[si].site_x - min_x) + "Y" +
+               std::to_string(ti.site_insts[si].site_y - min_y);
+    }
+
+    void write_io_config_usp(CellInfo *pad)
+    {
+        NetInfo *pad_net = pad->getPort(id_PAD);
+        NPNR_ASSERT(pad_net != nullptr);
+        std::string iostandard = str_or_default(pad->attrs, id_IOSTANDARD, "LVCMOS33");
+        std::string pulltype = str_or_default(pad->attrs, id_PULLTYPE, "NONE");
+        std::string slew = str_or_default(pad->attrs, id_SLEW, "SLOW");
+        int drive = int_or_default(pad->attrs, id_DRIVE, 12);
+
+        bool is_output = pad_net->driver.cell != nullptr;
+        bool is_input = false;
+        for (auto &usr : pad_net->users)
+            if (boost::contains(usr.cell->type.str(ctx), "INBUF"))
+                is_input = true;
+
+        // prjuray keys IOB features by the site's position WITHIN the tile --
+        // HDIO_TOP_RIGHT.IOB_X0Y7.PULLTYPE.NONE -- which is exactly what
+        // getSiteLocInTile() returns (SiteInstInfoPOD::rel_x / rel_y).
+        std::string tile = get_tile_name(pad->bel.tile);
+        push(tile);
+        push(usp_site_index_in_tile(pad->bel));
+        if (is_input)
+            write_choice("IOSTANDARD_IN", iostandard);
+        if (is_output) {
+            // dump_features.tcl writes $sn.IOSTANDARD_OUT.$iostd; 031-iob-spec
+            // folds drive and slew into that name, which is how the database
+            // spells it: LVCMOS33_IDRIVE_I12_SLEW_SLEW_SLOW.
+            write_choice("IOSTANDARD_OUT",
+                         iostandard + "_IDRIVE_I" + std::to_string(drive) + "_SLEW_SLEW_" + slew);
+            if (is_input)
+                write_choice("IOSTANDARD_IN_OUT", iostandard);
+        }
+        write_choice("PULLTYPE", pulltype);
+        pop(2);
+
+        // Bank voltage is a per-bank bit that lives in the HDIO_TOP_RIGHT tile.
+        if (boost::starts_with(tile, "HDIO_TOP_RIGHT")) {
+            bool low = iostandard == "LVCMOS12" || iostandard == "LVCMOS15" || iostandard == "LVCMOS18";
+            (low ? usp_lv_banks : usp_hv_banks).insert(pad->bel.tile);
+        }
+    }
+
+    void write_io_usp()
+    {
+        for (auto &cell : ctx->cells) {
+            CellInfo *ci = cell.second.get();
+            if (ci->type == id_IOB_PAD && ci->bel != BelId()) {
+                write_io_config_usp(ci);
+                blank();
+            }
+        }
+        for (int tile : usp_hv_banks) {
+            push(get_tile_name(tile));
+            write_choice("BANK_VOLTAGE", "HIGH_VOLTAGE");
+            pop();
+        }
+        for (int tile : usp_lv_banks) {
+            if (usp_hv_banks.count(tile))
+                log_error("tile %s has both a low- and a high-voltage IO standard\n", get_tile_name(tile).c_str());
+            push(get_tile_name(tile));
+            write_choice("BANK_VOLTAGE", "LOW_VOLTAGE");
+            pop();
+        }
+        blank();
+    }
+
+    // Clock distribution and route tracks carry a per-tile "this track is in
+    // use" bit, the UltraScale+ analogue of the 7-series HROW USED bits.
+    // dump_features.tcl applies it to two different wire sets depending on the
+    // tile type, so both lists are reproduced exactly.
+    static bool usp_wire_used_feature(const std::string &tt, const std::string &wire)
+    {
+        static const char *group_a[] = {"RCLK_BRAM_INTF_L",  "RCLK_BRAM_INTF_TD_L",      "RCLK_BRAM_INTF_TD_R",
+                                        "RCLK_CLEL_L_L",     "RCLK_CLEL_L",              "RCLK_CLEL_L_R",
+                                        "RCLK_CLEM_CLKBUF_L", "RCLK_CLEM_L",             "RCLK_DSP_INTF_L",
+                                        "RCLK_DSP_INTF_R",   "RCLK_RCLK_URAM_INTF_L_FT", "RCLK_CLEM_R",
+                                        "RCLK_CLEL_R",       "GTH_QUAD_RIGHT"};
+        static const char *group_b[] = {"RCLK_DSP_INTF_CLKBUF_L", "RCLK_CLEM_CLKBUF_L",
+                                        "RCLK_AMS_CFGIO",         "RCLK_INTF_LEFT_TERM_ALTO",
+                                        "RCLK_XIPHY_OUTER_RIGHT", "RCLK_RCLK_XIPHY_INNER_FT",
+                                        "RCLK_HDIO",              "GTH_QUAD_RIGHT"};
+        auto in = [&](const char *const *set, size_t n) {
+            for (size_t i = 0; i < n; i++)
+                if (tt == set[i])
+                    return true;
+            return false;
+        };
+        if (in(group_a, sizeof(group_a) / sizeof(*group_a)))
+            if (boost::starts_with(wire, "CLK_TEST_BUF_SITE_") || boost::starts_with(wire, "CLK_HROUTE_CORE_OPT") ||
+                boost::starts_with(wire, "CLK_VDISTR_BOT") || boost::starts_with(wire, "CLK_VDISTR_TOP") ||
+                boost::starts_with(wire, "CLK_VROUTE_BOT") || boost::starts_with(wire, "CLK_VROUTE_TOP"))
+                return true;
+        if (in(group_b, sizeof(group_b) / sizeof(*group_b)))
+            if (boost::starts_with(wire, "CLK_HROUTE") || boost::starts_with(wire, "CLK_HDISTR"))
+                return true;
+        if (tt == "CMT_L" || tt == "CMT_RIGHT")
+            if (boost::starts_with(wire, "CLK_HROUTE_") || boost::starts_with(wire, "CLK_HDISTR_") ||
+                boost::starts_with(wire, "CLK_VDISTR_") || boost::starts_with(wire, "CLK_TEST_BUF_SITE_"))
+                return true;
+        return false;
+    }
+
+    void write_clocking_usp()
+    {
+        // A distribution wire is a NODE spanning every tile in the row, so walk
+        // the node's tile wires rather than the WireId the router recorded.
+        // Marking the whole node used is what the node means -- the track is
+        // driven along its length -- and is what makes the clock arrive.
+        std::set<std::pair<int, std::string>> emitted;
+        for (auto &net : ctx->nets) {
+            NetInfo *ni = net.second.get();
+            for (auto &w : ni->wires) {
+                WireId wire = w.first;
+                auto visit = [&](int tile, int index) {
+                    if (tile < 0 || tile >= ctx->chip_info->num_tiles)
+                        return;
+                    auto &ti = ctx->chip_info->tile_insts[tile];
+                    auto &tt = ctx->chip_info->tile_types[ti.type];
+                    if (index < 0 || index >= tt.num_wires)
+                        return;
+                    std::string tts = IdString(tt.type).str(ctx);
+                    std::string wname = IdString(tt.wire_data[index].name).str(ctx);
+                    if (!usp_wire_used_feature(tts, wname))
+                        return;
+                    if (!emitted.insert({tile, wname}).second)
+                        return;
+                    push(std::string(ti.name.get()));
+                    push("WIRE");
+                    write_choice(wname + ".USED", "V1");
+                    pop(2);
+                };
+                if (wire.tile == -1) {
+                    auto &node = ctx->chip_info->nodes[wire.index];
+                    for (int i = 0; i < node.num_tile_wires; i++)
+                        visit(node.tile_wires[i].tile, node.tile_wires[i].index);
+                } else {
+                    visit(wire.tile, wire.index);
+                }
+            }
+        }
+        blank();
+    }
