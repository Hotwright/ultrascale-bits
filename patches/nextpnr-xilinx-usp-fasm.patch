+    // ------------------------------------------------------------------
+    // UltraScale+ CLE
+    //
+    // Three things differ from 7-series and all three change the feature
+    // name, so none of the writers above can be reused:
+    //
+    //  1. The tile holds ONE slice of eight LUTs (A..H), not two of four,
+    //     so there is no SLICE*_X* level at all. prjuray writes
+    //     CLEM_X7Y153.ALUT.INIT[63:0], not ...SLICEL_X0.ALUT.INIT[63:0].
+    //  2. Booleans are an explicit two-sided choice -- CLKINV.V0 / .V1,
+    //     MODE.FF / .LATCH -- and BOTH sides can carry set bits. AFF.INIT.V0
+    //     SETS 12_02 while .V1 clears it, so "write the bit only when true",
+    //     which is what write_bit() does, would silently drop it.
+    //  3. Flip-flop control is grouped per half (ABCD / EFGH) with a separate
+    //     CE/SR pair for each of the two FF ranks: ABCDFF carries CLKINV,
+    //     SRINV, MODE and SYNC plus rank-1 CEUSED/SRUSED, and ABCDFF2
+    //     carries only rank-2 CEUSED/SRUSED.
+    //
+    // Names checked against prjuray-db/zynqusp/segbits_clem.db.
+    static const char *cle_letters() { return "ABCDEFGH"; }
+
+    // Write an explicit .V0/.V1 choice.
+    void write_bool(const std::string &name, bool value)
+    {
+        write_prefix();
+        out << name << (value ? ".V1" : ".V0") << std::endl;
+    }
+
+    // Write an explicit named choice, e.g. write_choice("MODE", "LATCH").
+    void write_choice(const std::string &name, const std::string &value)
+    {
+        write_prefix();
+        out << name << "." << value << std::endl;
+    }
+
+    BelId get_site_bel_usp(int tile)
+    {
+        return ctx->getBelByLocation(Loc(tile % ctx->chip_info->width, tile / ctx->chip_info->width, 0));
+    }
+
+    void write_luts_config_usp(int tile)
+    {
+        auto lts = ctx->tileStatus[tile].lts;
+        if (lts == nullptr)
+            return;
+        std::string tname = get_tile_name(tile);
+        // CLEM / CLEM_R hold a SLICEM; CLEL_L / CLEL_R hold a SLICEL.
+        bool is_slicem = boost::starts_with(tname, "CLEM");
+        BelId site_bel = get_site_bel_usp(tile);
+        if (site_bel == BelId())
+            return;
+
+        push(tname);
+        bool wa7_used = false, wa8_used = false, wa9_used = false;
+        bool any_lut = false;
+
+        for (int i = 0; i < 8; i++) {
+            char c = cle_letters()[i];
+            CellInfo *lut6 = lts->cells[(i << 4) | BEL_6LUT];
+            CellInfo *lut5 = lts->cells[(i << 4) | BEL_5LUT];
+            if (lut6 != nullptr || lut5 != nullptr) {
+                any_lut = true;
+                push(std::string("") + c + std::string("LUT"));
+                write_vector("INIT[63:0]", get_lut_init(lut6, lut5));
+
+                bool is_small = false, is_ram = false, is_srl = false;
+                for (int j = 0; j < 2; j++) {
+                    CellInfo *lut = (j == 1) ? lut5 : lut6;
+                    if (lut == nullptr)
+                        continue;
+                    std::string type = str_or_default(lut->attrs, id_X_ORIG_TYPE);
+                    if (type == "RAMD64E" || type == "RAMS64E") {
+                        is_ram = true;
+                    } else if (type == "RAMD32" || type == "RAMS32") {
+                        is_ram = true;
+                        is_small = true;
+                    } else if (type == "SRL16E") {
+                        is_srl = true;
+                        is_small = true;
+                    } else if (type == "SRLC32E") {
+                        is_srl = true;
+                    }
+                    wa7_used |= (lut->getPort(id_WA7) != nullptr);
+                    wa8_used |= (lut->getPort(id_WA8) != nullptr);
+                    wa9_used |= (lut->getPort(id_WA9) != nullptr);
+                }
+                // MODE and SIZE exist only where the LUT can be memory. A
+                // SLICEL cannot, and prjuray has no CLEL_L/CLEL_R entry for
+                // either -- emitting them there assembles to nothing at all.
+                if (is_slicem) {
+                    write_choice("MODE", is_ram ? "RAM" : is_srl ? "SRL" : "LUT");
+                    write_choice("SIZE", is_small ? "SMALL" : "LARGE");
+                } else if (is_ram || is_srl) {
+                    log_error("LUT memory placed on a SLICEL in tile %s\n", tname.c_str());
+                }
+                pop();
+            }
+            // OUTMUX<c> and, in a SLICEM, <c>LUT.DI1 come out of the chipdb
+            // with the names prjuray uses, so write_routing_bel() needs no help.
+            write_routing_bel(get_site_wire(site_bel, std::string("") + c + std::string("MUX")));
+        }
+
+        if (any_lut && is_slicem) {
+            write_bool("WA7USED", wa7_used);
+            write_bool("WA8USED", wa8_used);
+            write_bool("WA9USED", wa9_used);
+        }
+        pop();
+    }
+
+    void write_ffs_config_usp(int tile)
+    {
+        auto lts = ctx->tileStatus[tile].lts;
+        if (lts == nullptr)
+            return;
+        std::string tname = get_tile_name(tile);
+        push(tname);
+
+        // Per-half control state. [half][rank]; rank 1 is the only one that
+        // carries CLKINV / SRINV / MODE / SYNC.
+        struct CtrlGroup
+        {
+            bool used = false;
+            bool latch = false, sync = false, clkinv = false, srinv = false;
+            bool srused[2] = {false, false};
+            bool ceused[2] = {false, false};
+            bool rank_used[2] = {false, false};
+        } group[2];
+
+        for (int i = 0; i < 8; i++) {
+            int half = i / 4; // 0 = ABCD, 1 = EFGH
+            for (int j = 0; j < 2; j++) {
+                CellInfo *ff = lts->cells[(i << 4) | (j == 1 ? BEL_FF2 : BEL_FF)];
+                if (ff == nullptr)
+                    continue;
+                bool zrst = false;
+                bool zinit = (int_or_default(ff->params, id_INIT, 0) != 1);
+                bool negedge_ff = false, is_latch = false, is_sync = false;
+                std::string type = str_or_default(ff->attrs, id_X_ORIG_TYPE, "");
+                if (type == "FDRE" || type == "FDRE_1") {
+                    zrst = true;
+                    is_sync = true;
+                } else if (type == "FDSE" || type == "FDSE_1") {
+                    is_sync = true;
+                } else if (type == "FDCE" || type == "FDCE_1") {
+                    zrst = true;
+                } else if (type == "FDPE" || type == "FDPE_1") {
+                    // zrst stays false, async
+                } else if (type == "LDCE" || type == "LDPE") {
+                    zrst = (type == "LDCE");
+                    is_latch = true;
+                } else {
+                    log_error("unsupported FF type: '%s'\n", type.c_str());
+                }
+                negedge_ff = boost::ends_with(type, "_1");
+
+                // Per-FF init/reset value. Both sides carry bits, so always
+                // write one: AFF.INIT.V0 sets 12_02, AFF.INIT.V1 clears it.
+                push(get_bel_name(ff->bel));
+                write_choice("INIT", zinit ? "V0" : "V1");
+                write_choice("SRVAL", zrst ? "V0" : "V1");
+                pop();
+
+                NetInfo *sr = ff->getPort(id_SR), *ce = ff->getPort(id_CE);
+                auto &g = group[half];
+                g.used = true;
+                g.rank_used[j] = true;
+                g.latch = g.latch || is_latch;
+                g.sync = g.sync || is_sync;
+                g.clkinv = g.clkinv || negedge_ff || int_or_default(ff->params, id_IS_C_INVERTED) == 1;
+                // yosys spells "this FF has no reset" as SR tied to the constant
+                // VCC net with IS_R_INVERTED=1, so the effective reset is a
+                // constant 0. Testing only against GND, as the 7-series writer
+                // does, calls that a used reset and then SRINV.V1 has to undo
+                // it. Treat EITHER constant as unused and the question goes away.
+                bool sr_is_const = sr == nullptr || sr->name == ctx->id("$PACKER_GND_NET") ||
+                                   sr->name == ctx->id("$PACKER_VCC_NET");
+                g.srused[j] = g.srused[j] || !sr_is_const;
+                if (!sr_is_const)
+                    g.srinv = g.srinv || int_or_default(ff->params, id_IS_R_INVERTED) == 1 ||
+                              int_or_default(ff->params, id_IS_S_INVERTED) == 1;
+                g.ceused[j] = g.ceused[j] || (ce != nullptr && ce->name != ctx->id("$PACKER_VCC_NET"));
+
+                // FFMUX<c><1|2> input select.
+                write_routing_bel(ctx->getBelPinWire(ff->bel, id_D));
+            }
+        }
+
+        for (int half = 0; half < 2; half++) {
+            auto &g = group[half];
+            if (!g.used)
+                continue;
+            std::string base = half ? "EFGH" : "ABCD";
+            push(base + "FF");
+            write_choice("MODE", g.latch ? "LATCH" : "FF");
+            write_choice("SYNC", g.sync ? "SYNC" : "ASYNC");
+            write_bool("CLKINV", g.clkinv);
+            write_bool("SRINV", g.srinv);
+            write_bool("CEUSED", g.ceused[0]);
+            write_bool("SRUSED", g.srused[0]);
+            pop();
+            if (g.rank_used[1]) {
+                push(base + "FF2");
+                write_bool("CEUSED", g.ceused[1]);
