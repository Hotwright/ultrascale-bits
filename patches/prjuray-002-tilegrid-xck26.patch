 FUZDIR=$(shell pwd)
 BUILD_FOLDER=build_${URAY_PART}
 BUILD_DIR=$(FUZDIR)/$(BUILD_FOLDER)
+# Four sub-fuzzers were removed for the XCK26 because the tile types they target
+# do not exist on this die. Counted in the tile dump this fuzzer itself produces
+# (build_<part>/tiles/tiles.txt):
+#
+#   hpio_right        HPIO_RIGHT        0   (the K26 has HPIO_L,        8)
+#   bitslice_tiles    XIPHY_BYTE_RIGHT  0   (the K26 has XIPHY_BYTE_L, 16)
+#   cmt_right         CMT_RIGHT         0
+#   rclk_pss_alto     RCLK_PSS_ALTO     0
+#
+# tilegrid.json depends on EVERY .tdb in this list, so leaving them in means
+# make never reaches the final target no matter how the sub-fuzzer fails.
+# add_tdb.py itself already skips a missing .tdb, so dropping them here costs
+# nothing beyond those tile types, which the die does not have.
 TILEGRID_TDB_DEPENDENCIES=
 TILEGRID_TDB_DEPENDENCIES += cle/$(BUILD_FOLDER)/segbits_tilegrid.tdb \
                              clel_int/$(BUILD_FOLDER)/segbits_tilegrid.tdb \
