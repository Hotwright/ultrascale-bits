+    x_max = max(grid.loc_of_tilename(t)[0] for t in grid.tiles())
+
     o = []
     for tile_name in sorted(grid.tiles()):
         loc = grid.loc_of_tilename(tile_name)
@@ -96,55 +98,61 @@
