# Upstream clones. These are plain clones with their own history, reproducible
# from the URL + SHA recorded in README-CLONES.md, so they are not vendored
# here. prjuray's build needs the patches in patches/ applied on top - see
# README-CLONES.md for the exact sequence.
/prjuray/
/prjuray-db/
/nextpnr-xilinx/

# Fuzzer/build scratch
/work/
*.pyc
__pycache__/

# Generated by designs/*/build.sh. The synthesis JSON is ~9 MB (yosys writes
# the whole Xilinx cell library into it) and the routed JSON is large too; both
# are reproducible in seconds. The .fasm IS kept, as the reference output that
# tools/check_fasm_vs_uraydb.py is checked against.
designs/*/*.json
