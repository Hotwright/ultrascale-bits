# Upstream clones. These are plain clones with their own history, reproducible
# from the URL + SHA recorded in README-CLONES.md, so they are not vendored
# here. prjuray's build needs the patches in patches/ applied on top - see
# README-CLONES.md for the exact sequence.
/prjuray/
/prjuray-db/
/nextpnr-xilinx/

# Fuzzer/build scratch
/work/
*.pyc
__pycache__/

# Generated by designs/*/build.sh. The synthesis JSON is ~9 MB (yosys writes
# the whole Xilinx cell library into it) and the routed JSON is large too; both
# are reproducible in seconds. The .fasm IS kept, as the reference output that
# tools/check_fasm_vs_uraydb.py is checked against.
designs/*/*.json
designs/*/*.filtered.fasm

# Generated by designs/make_bitstream.sh. The .bit is 7.8 MB of mostly-zero
# full-die configuration and rebuilds from the kept .fasm in a few seconds;
# .frames and .roundtrip.fasm are intermediates of that same run.
designs/*/*.bit
designs/*/*.bit.bin
designs/*/*.frames
designs/*/*.roundtrip.fasm

# Generated by env/reference_build.sh -- a whole Vivado project plus its .bit,
# .dcp and decoded .fasm. Reproducible from the design sources and the .tcl,
# and large. The point of the run is the comparison it prints, not the files.
designs/*/reference/
# Vivado drops these in whatever directory it was launched from.
/.Xil/
/clockInfo.txt
